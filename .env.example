# Copy to .env.local and fill in what you use. Everything here is optional —
# the site builds and runs with none of it set.

# Cloudflare Web Analytics site token. Unset, no beacon script is rendered.
# Found under Analytics & Logs → Web Analytics → your site → Manage site.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# GitHub token for the build-time star counts in site.config.tsx. Unset, the
# fetch runs unauthenticated (60 requests/hour per IP — often already spent
# on shared CI), and a failed fetch falls back to the hardcoded figure.
# Any fine-grained token with no extra scopes will do.
GITHUB_TOKEN=
